{
  "name": "LibJpegTurbo",
  "version": "3.2.0",
  "description": "Portable libjpeg-turbo decoder for PaperS3 with bounded PSRAM allocations",
  "license": "BSD-3-Clause",
  "build": {
    "flags": [
      "-Wno-unused-variable",
      "-Wno-unused-function"
    ],
    "srcFilter": [
      "-<*>",
      "+<jcomapi.c>",
      "+<jdapimin.c>",
      "+<jdapistd.c>",
      "+<jdatasrc.c>",
      "+<jdcoefct.c>",
      "+<jdcolor.c>",
      "+<jddctmgr.c>",
      "+<jdhuff.c>",
      "+<jdicc.c>",
      "+<jdinput.c>",
      "+<jdmainct.c>",
      "+<jdmarker.c>",
      "+<jdmaster.c>",
      "+<jdmerge.c>",
      "+<jdphuff.c>",
      "+<jdpostct.c>",
      "+<jdsample.c>",
      "+<jdtrans.c>",
      "+<jerror.c>",
      "+<jidctflt.c>",
      "+<jidctfst.c>",
      "+<jidctint.c>",
      "+<jidctred.c>",
      "+<jmemmgr.c>",
      "+<jmemreader.c>",
      "+<jpeg_nbits.c>",
      "+<jquant1.c>",
      "+<jquant2.c>",
      "+<jutils.c>",
      "+<precision12/jdapistd-12.c>",
      "+<precision12/jdcoefct-12.c>",
      "+<precision12/jdcolor-12.c>",
      "+<precision12/jddctmgr-12.c>",
      "+<precision12/jdmainct-12.c>",
      "+<precision12/jdmerge-12.c>",
      "+<precision12/jdpostct-12.c>",
      "+<precision12/jdsample-12.c>",
      "+<precision12/jidctflt-12.c>",
      "+<precision12/jidctfst-12.c>",
      "+<precision12/jidctint-12.c>",
      "+<precision12/jidctred-12.c>",
      "+<precision12/jquant1-12.c>",
      "+<precision12/jquant2-12.c>",
      "+<precision12/jutils-12.c>"
    ]
  }
}
